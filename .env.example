# Copy to .env (repo root or backend/) and adjust. Never commit .env.
# In AWS these are set as Lambda environment variables by the CDK stack.

# --- Mode ---------------------------------------------------------------
# true  = run fully offline with generated demo data (no AWS account needed)
# false = use DynamoDB + real AWS accounts via STS AssumeRole
DEMO_MODE=true

# --- AWS ----------------------------------------------------------------
AWS_REGION=ap-south-1
# DynamoDB table used when DEMO_MODE=false
TABLE_NAME=finops
# SNS topic for email alerts (created by CDK)
ALERTS_TOPIC_ARN=
# Slack webhook URLs entered in the UI are stored as SSM SecureStrings under this prefix
SLACK_WEBHOOK_SSM_PREFIX=/finops/slack-webhook
# AWS account the platform runs in (customers' roles trust it). Empty = detected via STS.
PLATFORM_ACCOUNT_ID=
# Optional S3 URL of finops-readonly-role.yaml, enables the CloudFormation "quick create" link
CUSTOMER_TEMPLATE_URL=
# Collector Lambda for async manual refresh (set by CDK). Empty = refresh runs in-process.
COLLECTOR_FUNCTION_NAME=

# --- Cost Explorer guard ------------------------------------------------
# Minimum minutes between manual "Refresh" calls (Cost Explorer charges $0.01 per request)
REFRESH_COOLDOWN_MINUTES=60
# First collection backfills this many days; later runs re-read only the last few days
COST_BACKFILL_DAYS=90
COST_LOOKBACK_DAYS=7

# --- Pricing ------------------------------------------------------------
# Live EC2 prices from the AWS Pricing API (free); otherwise only the static prices.json
USE_PRICING_API=false

# --- Display ------------------------------------------------------------
# Fixed USD -> INR rate used by the currency toggle
USD_INR_RATE=88.0

# --- Remediation (write actions) ----------------------------------------
# Off by default. Also requires the separate remediation role in the customer account.
REMEDIATION_ENABLED=false

# --- Auth (ignored when DEMO_MODE=true) ---------------------------------
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_REGION=ap-south-1
# Hosted UI domain, e.g. finops-dev-123456789012.auth.ap-south-1.amazoncognito.com
COGNITO_DOMAIN=

# --- API ----------------------------------------------------------------
# Comma-separated origins allowed by CORS (local dev only; in AWS the API is same-origin)
CORS_ORIGINS=http://localhost:5173

# --- Frontend (Vite reads VITE_* vars from frontend/.env) ---------------
# Leave empty to call the API on the same origin (Vite dev proxy / CloudFront /api/*)
# VITE_API_BASE_URL=
